# ── 服务端 ─────────────────────────────────────────────
# 生产/本地 Express 端口（npm start / npm run serve）
PORT=3000

# ── DeepSeek（可选；留空即完全离线运行）────────────────
# 只在服务端读取。不要把真实 Key 写进前端，也不要把 .env 提交到 Git。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# AI 顾问调用限制（服务端硬限制，模型不可突破）
AI_ENABLED=true
AI_TIMEOUT_MS=15000
AI_MAX_REQUESTS_PER_HOUR=48
AI_MIN_INTERVAL_MS=1800
AI_MAX_TOKENS=700
AI_TEMPERATURE=0.65
